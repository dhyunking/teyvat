SITE_URL=https://teyvat.kr
# Created and linked to the project; server-side only.
BLOB_READ_WRITE_TOKEN=
SLACK_WEBHOOK_URL=
SLACK_FILE_LINKS_ENABLED=true
CRON_SECRET=

# NAVER WORKS user OAuth; Drive API requires the file scope.
NAVERWORKS_CLIENT_ID=
NAVERWORKS_CLIENT_SECRET=
# Must exactly match the Redirect URL registered in NAVER WORKS Developers.
NAVERWORKS_REDIRECT_URI=https://teyvat-pi.vercel.app/api/naverworks-oauth
NAVERWORKS_OAUTH_SCOPES=file mail
NAVERWORKS_MAILBOX=inquiry@teyvat.kr
# Set only after verifying an actual mail URL in the mailbox; replace its numeric ID with {mailId}.
NAVERWORKS_MAIL_URL_TEMPLATE=
CONTACT_MAIL_ENABLED=false
MAIL_SYNC_ENABLED=false
MAIL_SYNC_START_AT=
MAIL_POLL_SECRET=
# Optional seed for manual setup; normal setup uses the protected OAuth callback.
NAVERWORKS_REFRESH_TOKEN=
# Automatically generated in Production. Keep it stable for the encrypted token vault.
NAVERWORKS_TOKEN_ENCRYPTION_KEY=
# Company shared drive and the existing internal homepage-inquiries folder.
NAVERWORKS_SHARED_DRIVE_ID=
NAVERWORKS_DRIVE_PARENT_ID=
NAVERWORKS_DRIVE_FOLDER_URL=

# Optional customer receipt email. Incoming mailbox service is configured separately.
CONTACT_ACK_ENABLED=false
MESSAGIO_BASE_URL=https://api.messag.io
MESSAGIO_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_REPLY_TO_EMAIL=inquiry@teyvat.kr

GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# TEYVAT Studio administrator. Secrets are server-side only.
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_SECRET=
ADMIN_BOOTSTRAP_EXPIRES_AT=
# Synced from the project-scoped GitHub Actions VERCEL_TOKEN during deployment.
ADMIN_DEPLOY_TOKEN=
